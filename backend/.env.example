# RentGuard backend environment variables
# Copy this file to `.env` and fill in your real keys.

# Groq (primary LLM) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (fallback LLM) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides (defaults are sensible for a demo)
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash-lite

# Flask
FLASK_PORT=5000
FLASK_DEBUG=true
